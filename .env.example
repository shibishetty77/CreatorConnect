# CreatorConnect local database configuration
# Copy this file to .env (or .env.local) and replace the placeholders locally.
# Never commit .env, .env.local, or real credentials.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=creatorconnect
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_at_least_32_random_characters
# Optional. Defaults to 604800 (7 days). Must be 60-2592000.
AUTH_SESSION_TTL_SECONDS=604800

# Only used by `npm run auth:create-admin`. Never used for public registration.
ADMIN_USERNAME=platform.admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
